# 1. Bỏ qua các thư mục dependency ở mọi cấp (dù đã có ở dưới, thêm ở đây cho chắc)
node_modules/
.pnp
.pnp.js

# 2. Bỏ qua file môi trường (Rất quan trọng, tránh lộ pass DB)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Bỏ qua file hệ điều hành (Mac, Windows)
.DS_Store
Thumbs.db

# 4. Bỏ qua file cấu hình IDE (VS Code, WebStorm...)
.vscode/
.idea/
*.swp
*.swo

# 5. Bỏ qua file log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# 6. Bỏ qua thư mục build (nếu có build chung)
dist/
build/